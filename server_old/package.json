{
  "name": "mr-demo-pro-server",
  "version": "1.0.0",
  "description": "Mr Demo Pro Server",
  "main": "server.js",
  "scripts": {
    "start": "copy .env.production .env && node server.js",
    "dev": "copy .env.development .env && nodemon server.js",
    "dev:safe": "copy .env.development .env && node start-server.js",
    "build": "echo 'No build step required'",
    "test": "jest",
    "test:connection": "node test.js",
    "generate:checklist-pdf": "node scripts/test-demolition-checklist-pdf.js",
    "docker": "copy .env.production .env && docker build -t gcr.io/cosmic-answer-439316-f1/mr-demo-pro-server:latest .",
    "docker:build": "docker build -t gcr.io/cosmic-answer-439316-f1/mr-demo-pro-server:latest .",
    "docker:push": "docker push gcr.io/cosmic-answer-439316-f1/mr-demo-pro-server:latest",
    "deploy:cloud-run": "node deploy-cloud-run.js",
    "deploy:cloud-build": "gcloud builds submit --config cloudbuild.yaml .",
    "deploy": "node deploy-simple.js",
    "deploy:ci": "npm run deploy:cloud-build",
    "gcloud:build": "gcloud builds submit --config cloudbuild.yaml .",
    "gcloud:auth": "gcloud auth activate-service-account --key-file=service-account-file.json",
    "status": "node deployment-status.js",
    "status:cloud-run": "node deployment-status.js --cloud-run",
    "status:detailed": "node deployment-status.js --cloud-run --detailed",
    "health": "node test-health.js",
    "health:local": "SERVER_URL=http://localhost:5000 node test-health.js",
    "test:chatgpt": "node test-chatgpt.js",
    "test:production": "node test-production.js",
    "debug:live": "node debug-live-errors.js",
    "logs:cloud-run": "gcloud logging read 'resource.type=cloud_run_revision AND resource.labels.service_name=mr-demo-pro-server' --limit=50 --format='value(timestamp,severity,textPayload)'",
    "logs:tail": "gcloud logging tail 'resource.type=cloud_run_revision AND resource.labels.service_name=mr-demo-pro-server' --format='value(timestamp,severity,textPayload)'",
    "setup:cloud-run": "node setup-cloud-run.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/client-sts": "^3.962.0",
    "@aws-sdk/s3-request-presigner": "^3.962.0",
    "@google-cloud/documentai": "^8.0.0",
    "@google-cloud/storage": "^7.7.0",
    "@notionhq/client": "^2.2.14",
    "@sendgrid/mail": "^8.1.5",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "file-type": "^18.7.0",
    "form-data": "^4.0.4",
    "google-auth-library": "^9.0.0",
    "googleapis": "^128.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "openai": "^4.20.1",
    "pdfjs-dist": "^4.0.379",
    "pdfkit": "^0.17.1",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mr-demo-pro",
    "demo-pro",
    "project-management",
    "mongodb",
    "express"
  ],
  "author": "Mr Demo Pro Team",
  "license": "MIT",
  "overrides": {
    "gcp-metadata": "^6.1.1",
    "gaxios": "^6.7.1",
    "https-proxy-agent": "^7.0.6",
    "agent-base": "^7.1.4",
    "debug": "^4.4.1"
  }
}
