# Opinly (build-time only — never prefix with VITE_)
# Settings → Developers in the Opinly dashboard
OPINLY_API_KEY=
OPINLY_CDN_NAMESPACE=
# Or set the full CDN prefix explicitly:
# OPINLY_IMAGES_PREFIX=https://cdn.opinly.ai/your-21-char-cdn-namespace

# Public site origin (canonicals / SEO). Production stays mrdemopro.com.
VITE_SITE_URL=
# Optional: legacy API fallback if /blog-data is missing
# VITE_API_BASE_URL=https://your-api-url.com/api
# VITE_USE_STATIC_BLOG_DATA=true

# PostHog analytics — Project Settings → Project API Key (phc_..., public by design).
# Leave VITE_POSTHOG_KEY empty to disable. Host: https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (phx_...) for creating funnels/dashboards via the API — never prefix with VITE_
POSTHOG_PERSONAL_API_KEY=

# Google Places (quote form address autocomplete — required for complete address selection)
# Enable Maps JavaScript API + Places API (New) on the GCP project for this key.
VITE_GOOGLE_PLACES_API_KEY=your-google-places-api-key
