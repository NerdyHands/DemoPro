{
  "name": "mr-demo-pro-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:seo && npm run seo:fix && tsc -b && vite build && npm run postbuild:snap && npm run seo:validate && npm run audit:http",
    "build:full": "npm run generate:seo && npm run seo:fix && tsc -b && vite build && npm run postbuild:snap && npm run seo:validate",
    "build:no-seo": "tsc -b && vite build && npm run postbuild:snap",
    "build:no-snap": "npm run generate:seo && npm run seo:fix && tsc -b && vite build && npm run seo:validate",
    "postbuild:snap": "node scripts/react-snap-wrapper.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:robots": "node scripts/generate-robots.js",
    "generate:seo": "node scripts/generate-seo-files.js",
    "seo:fix": "node scripts/seo-audit-fix.js",
    "seo:validate": "node scripts/seo-validation.js",
    "seo:audit": "npm run seo:fix && npm run seo:validate",
    "audit:http": "node scripts/http-status-check.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "bootstrap": "^5.3.8",
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react-snap": "^1.23.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "include": [
      "/",
      "/services",
      "/contact",
      "/faqs",
      "/cleanout",
      "/deck-removal",
      "/fence-removal",
      "/interior-demo",
      "/shed-removal",
      "/junk-removal",
      "/thank-you",
      "/privacy",
      "/terms",
      "/blog"
    ],
    "skipThirdPartyRequests": true,
    "cacheAjaxRequests": false,
    "preloadImages": false,
    "fixWebpackChunksIssue": "CRA2",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--disable-web-security",
      "--disable-features=VizDisplayCompositor",
      "--disable-software-rasterizer",
      "--disable-background-timer-throttling",
      "--disable-backgrounding-occluded-windows",
      "--disable-renderer-backgrounding"
    ],
    "puppeteerExecutablePath": null,
    "puppeteer": {
      "timeout": 60000,
      "headless": true
    },
    "asyncScriptTags": false,
    "inlineCss": false,
    "removeBlobs": true,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true,
      "removeRedundantAttributes": true,
      "removeScriptTypeAttributes": true,
      "removeStyleLinkTypeAttributes": true,
      "useShortDoctype": true,
      "minifyCSS": true,
      "minifyJS": false
    }
  }
}
